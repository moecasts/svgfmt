{
  "name": "@svgfmt/cli",
  "version": "0.0.0",
  "type": "module",
  "description": "CLI tool for formatting SVG files",
  "bin": {
    "svgfmt": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "rstest",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@rslib/core": "^0.18.0",
    "@rstest/core": "^0.6.5",
    "@types/node": "^24.10.1",
    "execa": "8",
    "tempy": "^3.1.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@svgfmt/core": "workspace:^",
    "commander": "^14.0.2",
    "fast-glob": "^3.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
